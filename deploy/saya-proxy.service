# The same-origin proxy (Caddy) in front of dist/, as a service. Adjust the
# user, paths and env file; the env file holds the core and adapter tokens and
# must be readable by this user only (chmod 600). See docs/deployment.md.
[Unit]
Description=saya same-origin proxy (Caddy)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/saya
# Adapter routes come from SAYA_ADAPTERS in the env file: add an adapter there
# and restart. The Caddyfile imports /var/lib/saya-proxy/adapters.caddy.
ExecStartPre=/home/ubuntu/.bun/bin/bun --env-file=/home/ubuntu/saya-deploy/saya.env scripts/caddy-adapters.ts /var/lib/saya-proxy/adapters.caddy
ExecStart=/home/ubuntu/.local/bin/caddy run --config /home/ubuntu/saya-deploy/Caddyfile --adapter caddyfile --envfile /home/ubuntu/saya-deploy/saya.env
Environment=XDG_CONFIG_HOME=/var/lib/saya-proxy XDG_DATA_HOME=/var/lib/saya-proxy
StateDirectory=saya-proxy
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only

[Install]
WantedBy=multi-user.target
