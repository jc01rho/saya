{
    # Do not emit request headers, bodies, or message text to access or error logs.
    log default {
        output discard
    }
}

# Loopback-only default. For remote use, replace both this site address and the
# Origin matcher below with the same HTTPS public origin after adding separate
# user authentication. Do not expose the core or this listener directly.
http://127.0.0.1:8080 {
    root * dist
    encode zstd gzip

  # `route` keeps the directives below in the order written. Without it Caddy
  # sorts them: try_files would rewrite /api and /adapters to /index.html before
  # any handle runs, and `respond @blocked_write` would run after the handles,
  # letting a cross-site write through.
  route {
    # A default only (`?`): an upstream answer such as /media keeps its own.
    # Hashed assets and /api override it below.
    header ?Cache-Control "no-cache"
    # img-src allows https: because a photo on a message is an address on the
    # client's own CDN, which the contract says the browser may use directly.
    # Scripts and styles stay 'self'; nothing else is widened.
    header Content-Security-Policy "default-src 'self'; img-src 'self' https: data:; worker-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; script-src 'self'; style-src 'self'"

    @api path /api/*
    header @api >Cache-Control "no-store"

    # The link-preview endpoint. It is NOT the cores' contract, which is why it
    # lives outside /api, holds no token and never reaches a core. Run it with
    # `SAYA_UNFURL_PORT=8791 bun server/serve.ts`, bound to loopback: it has no
    # authentication of its own and this listener is what fronts it. Omit this
    # block entirely and the client simply draws plain links.
    @unfurl path /unfurl /unfurl/*
    handle @unfurl {
        reverse_proxy 127.0.0.1:8791
    }

    # Browser writes must be JSON and demonstrably originate at this site. The
    # inverse match fails closed when Origin or Fetch Metadata is absent.
    @blocked_write {
        method POST PUT PATCH DELETE
        not {
            header Origin http://127.0.0.1:8080
            header Sec-Fetch-Site same-origin
            header Content-Type application/json*
        }
    }
    respond @blocked_write 403

    handle @api {
        uri strip_prefix /api
        reverse_proxy {env.SAYA_CORE_URL} {
            # This process expands the secret; the static files and browser do not.
            header_up Authorization "Bearer {env.SAYA_CORE_TOKEN}"
            # Send each SSE chunk immediately. Do not add a stream/idle timeout:
            # the upstream contract does not specify a ping cadence.
            flush_interval -1
        }
    }

    # Two cores, one at a time (kanao on a PC, kamado on a Mac): list both and
    # let the proxy follow whichever answers /health, which needs no token.
    # Both must be given the same token. Write the URLs literally; see
    # docs/deployment.md, "Following whichever core is up".
    #
    # handle @api {
    #     uri strip_prefix /api
    #     reverse_proxy https://pc.example.ts.net:8765 https://mac.example.ts.net:8765 {
    #         lb_policy first
    #         health_uri /health
    #         health_interval 5s
    #         health_timeout 3s
    #         lb_try_duration 3s
    #         header_up Authorization "Bearer {env.SAYA_CORE_TOKEN}"
    #         header_up Host {upstream_hostport}
    #         flush_interval -1
    #     }
    # }

    # Messenger adapters (tsuba). The client reads the index, which names ids
    # only; each adapter is its own upstream with its own token, expanded here.
    # Add one handle per id listed in the index. Writes are still filtered by
    # @blocked_write above.
    @adapters_index path /adapters
    handle @adapters_index {
        header Cache-Control "no-store"
        header Content-Type "application/json; charset=utf-8"
        respond `{"adapters":[{"id":"telegram"}]}` 200
    }

    # `/media` answers bytes somebody else sent, so every adapter answer is
    # sandboxed and never sniffed whatever the adapter says (`>` defers the
    # set until after the upstream's headers). `/media` keeps its own private
    # cache header; everything else defaults to no-store.
    @adapter_telegram path /adapters/telegram/*
    header @adapter_telegram {
        ?Cache-Control "no-store"
        >Content-Security-Policy "default-src 'none'; sandbox"
        >X-Content-Type-Options "nosniff"
    }
    handle @adapter_telegram {
        uri strip_prefix /adapters/telegram
        # If the adapter sits under a path (tailscale serve --set-path /telegram),
        # keep only scheme://host:port in the URL and add the path back here:
        # rewrite * /telegram{uri}
        reverse_proxy {env.SAYA_ADAPTER_TELEGRAM_URL} {
            header_up Authorization "Bearer {env.SAYA_ADAPTER_TELEGRAM_TOKEN}"
            # An HTTPS upstream (e.g. tailscale serve) routes on its own host name.
            header_up Host {upstream_hostport}
            flush_interval -1
        }
    }

    @hashed_assets path_regexp hashed ^/assets/.+\.[a-zA-Z0-9_-]{8,}\.(?:css|js|mjs|woff2?|svg|png|jpe?g|webp|gif)$
    header @hashed_assets Cache-Control "public, max-age=31536000, immutable"

    # Everything else is the static client, with the SPA fallback.
    handle {
        try_files {path} /index.html
        file_server
    }
  }
}
